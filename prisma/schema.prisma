generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  CUSTOMER
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  PHONEPE
  SNAPMIT
}

enum InventoryReason {
  INITIAL_STOCK
  ADJUSTMENT
  ORDER_RESERVATION
  ORDER_COMPLETED
  ORDER_CANCELLED
  RETURN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum HomepageSectionType {
  HERO
  FEATURED_PRODUCTS
  CATEGORIES
  BRANDS
  COLLECTION
  PROMO_BANNER
  TRUST
}

model Store {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  currency         String            @default("INR")
  products         Product[]
  categories       Category[]
  brands           Brand[]
  collections      Collection[]
  sellers          Seller[]
  shippingRules    ShippingRule[]
  taxRules         TaxRule[]
  searchEvents     SearchEvent[]
  homepageSections HomepageSection[]
  homepageBanners  HomepageBanner[]
  mediaAssets      MediaAsset[]
  settings         StoreSettings?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  passwordHash          String
  name                  String
  role                  Role                   @default(CUSTOMER)
  isActive              Boolean                @default(true)
  addresses             Address[]
  carts                 Cart[]
  orders                Order[]
  wishlistItems         WishlistItem[]
  reviews               Review[]
  auditLogs             AuditLog[]             @relation("actorAuditLogs")
  inventoryTransactions InventoryTransaction[] @relation("inventoryActor")
  couponUsages          CouponUsage[]
  notifications         Notification[]
  seller                Seller?
  phone                 String?                @unique
  searchEvents          SearchEvent[]
  resetTokens           PasswordResetToken[]
  // A fallback way to reset a password without an email — mainly for phone-only accounts. The answer is hashed
  // like a password and never stored or returned in plain text.
  securityQuestion      String?
  securityAnswerHash    String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Category {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String
  imageUrl       String?
  description    String?
  seoTitle       String?
  seoDescription String?
  isVisible      Boolean    @default(true)
  position       Int        @default(0)
  products       Product[]

  @@unique([storeId, slug])
  @@index([storeId, parentId, position])
}

model Brand {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  logoUrl     String?
  description String?
  isActive    Boolean   @default(true)
  products    Product[]

  @@unique([storeId, slug])
}

model Product {
  id             String              @id @default(cuid())
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sellerId       String?
  seller         Seller?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  name           String
  slug           String
  description    String              @db.Text
  condition      ProductCondition    @default(NEW)
  status         ProductStatus       @default(DRAFT)
  basePrice      Int
  salePrice      Int?
  costPrice      Int?
  taxRate        Int                 @default(18)
  sku            String              @unique
  warrantyMonths Int                 @default(0)
  specifications Json?
  dimensions     Json?
  tags           String[]            @default([])
  grade          String?
  whatsIncluded  String?             @db.Text
  seoTitle       String?
  seoDescription String?
  images         ProductImage[]
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  collections    ProductCollection[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  @@unique([storeId, slug])
  @@index([storeId, status, categoryId])
  @@index([name])
  @@index([sellerId])
}

model Seller {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  slug      String
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, slug])
}

model Collection {
  id             String              @id @default(cuid())
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  imageUrl       String?
  isActive       Boolean             @default(true)
  seoTitle       String?
  seoDescription String?
  products       ProductCollection[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([storeId, slug])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId, position])
}

model ProductVariant {
  id                    String                      @id @default(cuid())
  productId             String
  product               Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title                 String
  sku                   String                      @unique
  barcode               String?
  price                 Int?
  salePrice             Int?
  stock                 Int                         @default(0)
  lowStockThreshold     Int                         @default(2)
  weightGrams           Int?
  attributes            Json?
  images                ProductImage[]
  inventoryTransactions InventoryTransaction[]
  reservations          InventoryReservation[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  sensitiveInfo         SensitiveDeviceInformation?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([productId, stock])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String?
  position  Int             @default(0)
}

model SensitiveDeviceInformation {
  id                   String         @id @default(cuid())
  variantId            String         @unique
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imeiEncrypted        String?
  batteryHealth        Int?
  repairHistory        String?        @db.Text
  deviceCondition      String?
  screenCondition      String?
  bodyCondition        String?
  accessoriesIncluded  String?
  refurbishmentDetails String?        @db.Text
  activationStatus     String?
  accessedAt           DateTime?
}

model InventoryTransaction {
  id             String          @id @default(cuid())
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityDelta  Int
  previousStock  Int
  resultingStock Int
  reason         InventoryReason
  reference      String?
  actorId        String?
  actor          User?           @relation("inventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([variantId, createdAt])
}

model InventoryReservation {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?

  @@index([variantId, expiresAt])
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  couponCode   String?
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([cartId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
}

model Coupon {
  id               String        @id @default(cuid())
  code             String        @unique
  type             DiscountType
  value            Int
  minimumOrder     Int?
  maximumDiscount  Int?
  startsAt         DateTime      @default(now())
  expiresAt        DateTime?
  usageLimit       Int?
  usedCount        Int           @default(0)
  isActive         Boolean       @default(true)
  firstOrderOnly   Boolean       @default(false)
  perCustomerLimit Int?
  scopeType        String        @default("ORDER")
  scopeIds         Json?
  usages           CouponUsage[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount  Int
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

model Order {
  id                String                 @id @default(cuid())
  orderNumber       String                 @unique
  confirmationToken String                 @unique @default(cuid())
  userId            String?
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            OrderStatus            @default(PENDING)
  paymentStatus     PaymentStatus          @default(PENDING)
  subtotal          Int
  discount          Int                    @default(0)
  shippingAmount    Int                    @default(0)
  taxAmount         Int                    @default(0)
  cgstAmount        Int                    @default(0)
  sgstAmount        Int                    @default(0)
  igstAmount        Int                    @default(0)
  total             Int
  currency          String                 @default("INR")
  shippingAddress   Json
  billingAddress    Json?
  couponCode        String?
  internalNotes     String?                @db.Text
  items             OrderItem[]
  payments          Payment[]
  reservations      InventoryReservation[]
  refunds           Refund[]
  shipment          Shipment?
  couponUsage       CouponUsage?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  sku       String
  unitPrice Int
  quantity  Int
  taxRate   Int
}

model Payment {
  id                   String               @id @default(cuid())
  orderId              String
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway              PaymentGateway
  gatewayTransactionId String?              @unique
  amount               Int
  currency             String               @default("INR")
  status               PaymentStatus        @default(PENDING)
  metadata             Json?
  idempotencyKey       String               @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  transactions         PaymentTransaction[]
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  gatewayEventId String?       @unique
  type           String
  status         PaymentStatus
  amount         Int
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([paymentId, createdAt])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId       String?
  gatewayRefundId String?      @unique
  amount          Int
  reason          String
  status          RefundStatus @default(REQUESTED)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderId, createdAt])
}

model ShippingRule {
  id                    String   @id @default(cuid())
  storeId               String
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                  String
  states                String[]
  pincodes              String[]
  minimumOrder          Int?
  maximumOrder          Int?
  charge                Int
  freeShippingThreshold Int?
  estimatedDaysMin      Int      @default(3)
  estimatedDaysMax      Int      @default(7)
  isActive              Boolean  @default(true)
  priority              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([storeId, priority])
}

model TaxRule {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  rate      Int
  homeState String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        String?
  trackingNumber String?        @unique
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  estimatedAt    DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Review {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  body             String        @db.Text
  isVisible        Boolean       @default(false)
  verifiedPurchase Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  images           ReviewImage[]

  @@unique([productId, userId])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)
}

model StoreSettings {
  id                    String         @id @default(cuid())
  storeId               String         @unique
  store                 Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logoUrl               String?
  faviconUrl            String?
  supportEmail          String?
  supportPhone          String?
  address               Json?
  gstin                 String?
  defaultTaxRate        Int            @default(18)
  freeShippingThreshold Int            @default(49900)
  cancellationHours     Int            @default(1)
  returnDays            Int            @default(7)
  defaultGateway        PaymentGateway @default(RAZORPAY)
  paymentConfig         Json?
  notificationConfig    Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model HomepageSection {
  id        String              @id @default(cuid())
  storeId   String
  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      HomepageSectionType
  title     String?
  subtitle  String?
  config    Json?
  position  Int                 @default(0)
  isVisible Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([storeId, position])
}

model HomepageBanner {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  position       Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isVisible      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, position])
}

model MediaAsset {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  url       String
  mimeType  String
  sizeBytes Int
  alt       String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId     String?
  channel     NotificationChannel
  template    String
  destination String?
  payload     Json
  status      NotificationStatus  @default(PENDING)
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("actorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model SearchEvent {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken String?
  query        String
  resultCount  Int
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([query])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

// Small editable content store: announcement bar, business details, policy wording.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
